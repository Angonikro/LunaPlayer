lunaplayer (1.0.0~dev7) unstable; urgency=medium

  * Fix startup crash: define the tray command callback before creating TrayController.
  * Fix desktop activation so a stale active window cannot leave a blank player.
  * Record startup exceptions in ~/.cache/lunaplayer/startup.log for diagnosis.
  * Keep the tray-enabled setting consistent on startup.

  * Add optional system-tray indicator with open and quit actions.
  * Add a persistent System-Tray toggle; when enabled, closing the window hides
    it to the tray, and when disabled, closing exits the application.
  * Keep tray integration in a separate GTK 3 helper process to avoid mixing
    GTK 3 and GTK 4 in the player process.

 -- LunaPlayer Project <maintainer@example.invalid>  Sat, 24 Oct 2026 22:00:00 +0200

#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VERSION=1.0.0~dev5
STAGE="$ROOT/build/deb"
rm -rf "$STAGE"
mkdir -p "$STAGE/DEBIAN" "$STAGE/usr/share/lunaplayer" "$STAGE/usr/bin" "$STAGE/usr/share/applications" "$STAGE/usr/share/icons/hicolor/scalable/apps" "$STAGE/usr/share/doc/lunaplayer"
chmod 755 "$STAGE/DEBIAN"; chmod g-s "$STAGE/DEBIAN"
cp "$ROOT/packaging/debian/control" "$STAGE/DEBIAN/control"
sed -i "s/^Version: .*/Version: $VERSION/" "$STAGE/DEBIAN/control"
cp "$ROOT/packaging/debian/changelog" "$STAGE/DEBIAN/changelog"
cp "$ROOT/packaging/debian/copyright" "$STAGE/usr/share/doc/lunaplayer/copyright"
cp "$ROOT/main.py" "$STAGE/usr/share/lunaplayer/main.py"
cp -r "$ROOT/app" "$ROOT/ui" "$STAGE/usr/share/lunaplayer/"
find "$STAGE/usr/share/lunaplayer" -type d -name __pycache__ -prune -exec rm -rf {} +
cp "$ROOT/data/icons/lunaplayer.svg" "$STAGE/usr/share/icons/hicolor/scalable/apps/lunaplayer.svg"
sed 's|^Exec=.*|Exec=/usr/bin/lunaplayer|; s|^Icon=.*|Icon=lunaplayer|' "$ROOT/data/desktop/lunaplayer.desktop" > "$STAGE/usr/share/applications/lunaplayer.desktop"
cat > "$STAGE/usr/bin/lunaplayer" <<'WRAPPER'
#!/bin/sh
exec /usr/bin/python3 /usr/share/lunaplayer/main.py "$@"
WRAPPER
chmod 755 "$STAGE/usr/bin/lunaplayer"
find "$STAGE" -type d -exec chmod 755 {} +
find "$STAGE" -type d -exec chmod g-s {} +
mkdir -p "$ROOT/dist"
dpkg-deb --build --root-owner-group "$STAGE" "$ROOT/dist/lunaplayer_${VERSION}_all.deb"
echo "Built $ROOT/dist/lunaplayer_${VERSION}_all.deb"

