[Desktop Entry]
Type=Application
Name=LunaPlayer
Comment=Moderner Musik- und Videoplayer
TryExec=lunaplayer
Exec=lunaplayer %F
Icon=/usr/share/pixmaps/lunaplayer.png
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/x-mpegurl;audio/mpegurl;application/vnd.apple.mpegurl;audio/mpeg;audio/mp3;audio/x-wav;audio/wav;audio/ogg;application/ogg;audio/flac;audio/x-flac;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/aiff;audio/x-aiff;audio/webm;video/mp4;video/x-m4v;video/x-matroska;video/x-msvideo;video/avi;video/mpeg;video/quicktime;video/webm;video/x-flv;video/x-ms-wmv;video/ogg;video/3gpp;video/3gpp2;video/x-ogm+ogg;
StartupNotify=true
